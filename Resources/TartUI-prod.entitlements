<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 虚拟机跑在 TartUI 进程内，虚拟化 entitlement 属于本 App。 -->
	<key>com.apple.security.virtualization</key>
	<true/>

	<!-- 桥接网络（RunProfile 的 .bridged）需要这一项。
	     它是 Apple 的受限 entitlement：光有 Developer Program 会员资格不够，
	     必须单独向 Apple 申请授权，并使用一个包含该权限的 provisioning
	     profile 签名，否则 AMFI 会在启动时直接终止进程。

	     还没拿到授权时，把这一项注释掉即可：NAT（.shared）不受影响。 -->
	<key>com.apple.vm.networking</key>
	<true/>
</dict>
</plist>
